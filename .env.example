# ==============================================================================
# CI/CD PIPELINE CONFIGURATION ENVIRONMENT VARIABLES
# Copy file này thành .env trước khi chạy: cp .env.example .env
# ==============================================================================

# COMPOSE SETTINGS
COMPOSE_PROJECT_NAME=cicd_pipeline_2026

# NETWORK CONFIGURATION
PIPELINE_NETWORK_NAME=cicd_pipeline_network

# JENKINS CONFIGURATION
JENKINS_IMAGE=jenkins/jenkins:lts-jdk17
JENKINS_PORT=8080
JENKINS_AGENT_PORT=50000

# SONARQUBE CONFIGURATION
SONARQUBE_IMAGE=sonarqube:lts-community
SONARQUBE_PORT=9000
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar_secure_password_2026
SONAR_DB_NAME=sonar

# POSTGRES CONFIGURATION (FOR SONARQUBE)
POSTGRES_IMAGE=postgres:15-alpine

# DOZZLE LOG VIEWER CONFIGURATION
DOZZLE_IMAGE=amir20/dozzle:latest
DOZZLE_PORT=8888
DOZZLE_LOG_LEVEL=info

# HADOLINT CONFIGURATION
HADOLINT_IMAGE=hadolint/hadolint:latest-debian
